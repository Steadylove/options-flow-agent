# 数据源。mock 为默认，离线、不访问网络。
# theta 会把 Terminal 的期权 ohlc / quote / open interest 映射成简报。连不上会失败，不会退回 mock。
# 不连 Terminal 时用 `pnpm test` 跑记录下来的 JSON 样本。
OPTIONS_DATA_PROVIDER=mock

# 默认不把当日到期合约放进异常排名。设为 1 则纳入。命令行 --include-0dte 同样有效。
INCLUDE_0DTE=

# 异常排名的未平仓下限。留空等于 500。设为 0 表示不设下限。命令行 --min-oi 优先。
MIN_OPEN_INTEREST=

# 标的价格。仅在 OPTIONS_DATA_PROVIDER=theta 时使用。
# yahoo（默认）：先请求 Yahoo Finance 公开图表，无需密钥；失败再用 Theta 免费日线 /stock/history/eod。
# theta-eod：只用免费日线收盘。不请求付费的 stock snapshot。
UNDERLYING_PRICE_SOURCE=yahoo

# Theta Terminal v3 的本地 REST。官方文档默认是本机 25503；staging Terminal 用 25504。
# v3 HTTP 文档没有单独的公有云主机。若以后要指到别的 Terminal，只改这一行。
THETADATA_BASE_URL=http://127.0.0.1:25503/v3

# 下面三项只给 Theta Terminal 自己启动时用。本进程的本地 REST 不读取它们，也不会放进请求。
# 留空即可。不要把真密钥提交进仓库。若在这里填写邮箱/密码，需要两个一起填。
THETADATA_API_KEY=
THETADATA_USERNAME=
THETADATA_PASSWORD=

# 可选。留空时 `pnpm brief` 走确定性离线路径：
# 仍会依次调用 fetchOptionsSummary → analyzeFlow → writeBrief。
# 这组变量只决定谁来编排 tool，不提供行情。
LITELLM_API_KEY=

# OpenAI 兼容的 LiteLLM 基址，代码会请求 ${LITELLM_BASE_URL}/chat/completions。
# 仅在设置了 LITELLM_API_KEY 时使用。
LITELLM_BASE_URL=http://localhost:4000/v1

# 传给 chat completions 的模型名。
LITELLM_MODEL=gpt-4o-mini
